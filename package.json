{
  "name": "@ocx-sh/catalog",
  "version": "0.5.3",
  "description": "Static Astro catalog renderer for OCX package indices (OCI-backed)",
  "keywords": [
    "ocx",
    "catalog",
    "package-index",
    "astro-component",
    "oci",
    "static-site-generator"
  ],
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ocx-sh/catalog.git"
  },
  "bugs": {
    "url": "https://github.com/ocx-sh/catalog/issues"
  },
  "homepage": "https://github.com/ocx-sh/catalog#readme",
  "type": "module",
  "bin": {
    "ocx-catalog": "dist/cli/index.js"
  },
  "exports": {
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "src/config/schema",
    "templates",
    "LICENSE",
    "README.md",
    "CHANGELOG.md"
  ],
  "sideEffects": [
    "**/*.css"
  ],
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "engines": {
    "node": ">=22.13"
  },
  "scripts": {
    "build": "tsc",
    "postbuild": "node scripts/postbuild.mjs",
    "prepack": "npm run build",
    "test": "vitest run --coverage",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@astrojs/markdown-satteri": "0.4.3",
    "@astrojs/sitemap": "^3.7.4",
    "@ocx-sh/theme": "file:/home/mherwig/dev/ocx-website/packages/theme",
    "astro": "~7.3",
    "commander": "^14.0.2",
    "dompurify": "^3.4.14",
    "highlight.js": "^11.12.0",
    "jsdom": "^29.1.1",
    "markdown-it": "^14.3.0",
    "markdown-it-emoji": "^3.1.0",
    "minisearch": "7.2.0",
    "yaml": "^2.8.0"
  },
  "devDependencies": {
    "@arethetypeswrong/cli": "^0.18.2",
    "@eslint/js": "^9.39.0",
    "@lhci/cli": "^0.15.0",
    "@types/markdown-it": "^14.2.0",
    "@types/node": "^24.10.0",
    "@vitest/coverage-v8": "^3.2.4",
    "ajv": "^8.18.0",
    "eslint": "^10.9.0",
    "globals": "^16.5.0",
    "happy-dom": "^20.11.6",
    "publint": "^0.3.14",
    "puppeteer-core": "24.43.1",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.67.0",
    "vitest": "^3.2.4"
  }
}

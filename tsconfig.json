{
  "compilerOptions": {
    "target": "ES2022",
    // DOM: src/site/lib holds browser-side logic shared with the theme (dom.ts,
    // sanitize.ts, …); the CLI code never touches it.
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "rootDir": "src",
    "outDir": "dist",
    "strict": true,
    "declaration": true,
    "declarationMap": true,
    "isolatedModules": true,
    "esModuleInterop": true,
    "forceConsistentCasingInFileNames": true,
    "skipLibCheck": true
  },
  "include": ["src"],
  // src/theme is VitePress-theme source (bundler-resolved, extensionless
  // relative imports, .vue SFCs) — not part of this package's Node-targeted
  // `dist/` build. Typechecked separately by tsconfig.theme.json.
  "exclude": ["src/theme"]
}
